script = ExtResource("1_br")
item_id = &"berry"
display_name = "浆果"
description = "酸甜的野生浆果。
右键食用：恢复 25 点饱食度，并回复 10 点生命。
（大纲 3.3.2：吃食物 = 补饱食度 且 回血，一起结算；饱食度已满时吃不下。）
来源：草原与丛林的浆果丛（空手可采，会再生）。"
item_type = 2
stackable = true
max_stack = 30
usable = true
use_effect = "+25_food +10_health"
consume_on_use = true
buy_price = 2
sell_price = 1
